# Digital Corp backup config example
BACKUP_MODE=DEDICATED_BACKUP_DISK_MODE
BACKUP_ROOT=/Volumes/DigitalCorpBackup/backups
BACKUP_MARKER=/Volumes/DigitalCorpBackup/.digital-corp-backup-marker
EXPECTED_MARKER_VALUE=DIGITAL_CORP_BACKUP_DISK=PRIMARY_BACKUP
MAX_BACKUPS=5
BACKUP_INTERVAL_SECONDS=1800
SOURCE_HERMES_HOME=$HOME/.hermes
SOURCE_DIGITAL_CORP=/path/to/digital-corp
BACKUP_LOG=$HOME/.hermes/logs/backup.log
INCLUDE_SECRETS_IN_LOCAL_BACKUP=true
CLOUD_BACKUP_ENABLED=false
