# Digital Corp backup config example
BACKUP_MODE=TEMPORARY_BACKUP_MODE
BACKUP_ROOT=/Volumes/256/digital-corp-backups
# Prefer a non-hidden marker under BACKUP_ROOT for macOS launchd readability.
# Root marker may also exist at /Volumes/256/.digital-corp-backup-marker.
BACKUP_MARKER=/Volumes/256/digital-corp-backups/DIGITAL_CORP_BACKUP_MARKER.txt
EXPECTED_MARKER_VALUE=DIGITAL_CORP_BACKUP_DISK=TEMP_256
MAX_BACKUPS=5
BACKUP_INTERVAL_SECONDS=1800
SOURCE_HERMES_HOME=$HOME/.hermes
SOURCE_DIGITAL_CORP=/Volumes/256/digital-corp
BACKUP_LOG=$HOME/.hermes/logs/backup.log
INCLUDE_SECRETS_IN_LOCAL_BACKUP=true
CLOUD_BACKUP_ENABLED=false
