<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.digitalcorp.dashboard.watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/admin/bin/digitalcorp_dashboard_watchdog.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/admin/Library/Logs/digitalcorp-dashboard.watchdog.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/admin/Library/Logs/digitalcorp-dashboard.watchdog.stderr.log</string>
</dict>
</plist>
