<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.digitalcorp.dashboard</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3.12</string>
        <string>-m</string><string>uvicorn</string>
        <string>main:app</string>
        <string>--host</string><string>0.0.0.0</string>
        <string>--port</string><string>3000</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Volumes/256/digital-corp/dashboard/backend</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key>
    <string>/Volumes/256/digital-corp/logs/dashboard.log</string>
    <key>StandardErrorPath</key>
    <string>/Volumes/256/digital-corp/logs/dashboard.error.log</string>
</dict>
</plist>
